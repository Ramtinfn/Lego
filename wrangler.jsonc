{
  // Cloudflare Worker configuration — https://developers.cloudflare.com/workers/wrangler/configuration/
  "name": "persiainbricks-showcase",
  "main": "src/worker.js",
  "compatibility_date": "2026-01-01",

  // The static site lives in ./public and is served by the Worker.
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },

  // The site's domain. Cloudflare provisions DNS and TLS automatically.
  "routes": [
    { "pattern": "persiainbricks.com", "custom_domain": true },
    { "pattern": "www.persiainbricks.com", "custom_domain": true }
  ]
}
